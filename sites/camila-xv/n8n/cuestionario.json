    {
      "parameters": {
        "jsCode": "// Junta las respuestas de todas las páginas en la forma de src/event.config.js.\n// Las páginas que se saltaron (por un \"No\") no se ejecutaron y quedan vacías.\nconst pagina = (nodo) => ($(nodo).isExecuted ? $(nodo).first().json : {});\nconst lineas = (texto) => String(texto || '').split('\\n').map((l) => l.trim()).filter(Boolean);\n\n// \"8:00 PM\" -> \"20:00\"\nconst hora24 = (texto) => {\n  const m = String(texto || '').trim().match(/^(\\d{1,2})(?::(\\d{2}))?\\s*([ap])?/i);\n  if (!m) return '20:00';\n  let h = Number(m[1]);\n  const ampm = (m[3] || '').toLowerCase();\n  if (ampm === 'p' && h < 12) h += 12;\n  if (ampm === 'a' && h === 12) h = 0;\n  return `${String(h).padStart(2, '0')}:${m[2] || '00'}`;\n};\n\nconst icono = (actividad) => {\n  const a = actividad.toLowerCase();\n  if (a.includes('vals')) return 'vals';\n  if (a.includes('foto')) return 'camara';\n  if (a.includes('fiesta') || a.includes('baile')) return 'disco';\n  if (a.includes('despedida') || a.includes('cierre')) return 'reloj';\n  if (a.includes('cena') || a.includes('brindis')) return 'copas';\n  return 'corona';\n};\n\n// Hoteles guardados que se ofrecen en la página \"Lista de hoteles\". Si agregas\n// uno aquí, agrégalo también como opción de \"Hoteles recomendados\".\nconst HOTELES = {\n  'Hotel Cadillac': {\n    nombre: 'Hotel Cadillac',\n    direccion: 'Juárez 206, Centro, Etzatlán, Jal.',\n    distancia: '',\n    telefono: '3867530114',\n    codigo: '',\n    mapsUrl: 'https://maps.app.goo.gl/y7Y99KGms3yBYNBC7',\n    url: 'http://www.hotelcadillac.com.mx',\n  },\n  'Hotel El Centenario': {\n    nombre: 'Hotel El Centenario',\n    direccion: 'Frente a la Plaza de Armas, Etzatlán, Jal.',\n    distancia: '',\n    telefono: '3867531561',\n    codigo: '',\n    mapsUrl: 'https://maps.app.goo.gl/pcfZtgx8JJZb9YKT6',\n    url: '',\n  },\n  'Hotel Cuatro Caminos': {\n    nombre: 'Hotel Cuatro Caminos',\n    direccion: 'Extramuros 238, Etzatlán, Jal.',\n    distancia: '',\n    telefono: '',\n    codigo: '',\n    mapsUrl: 'https://share.google/rreCl7qUvDKq6sg7Q',\n    url: '',\n  },\n};\n\nconst fiesta = pagina('La fiesta');\nconst familia = pagina('Familia');\nconst padrinos = pagina('Padrinos');\nconst misa = pagina('Datos de la misa');\nconst recepcion = pagina('Recepción');\nconst programa = pagina('Programa');\nconst vestimenta = pagina('Vestimenta');\nconst banco = pagina('Datos bancarios');\nconst hoteles = pagina('Lista de hoteles');\nconst detalles = pagina('Detalles');\nconst contacto = pagina('Contacto');\n\nconst fecha = String(fiesta['¿Qué día son los XV años de Camila?'] || '').slice(0, 10);\nconst color = vestimenta['¿Hay algún color reservado para Camila?'];\nconst clabe = String(banco['CLABE'] || '').replace(/\\D/g, '');\n\nconst config = {\n  hero: { titulo: fiesta['¿Cómo quiere aparecer Camila en la invitación?'] || 'Camila' },\n  fecha: `${fecha}T${hora24(fiesta['¿A qué hora empieza la celebración?'])}:00`,\n  mensaje: { texto: fiesta['Mensaje de Camila para sus invitados'] || '' },\n  familia: {\n    grupos: [\n      {\n        titulo: '',\n        nombres: [familia['Nombre completo del papá de Camila'], familia['Nombre completo de la mamá de Camila']].filter(Boolean),\n      },\n      ...lineas(padrinos['Padrinos de Camila']).map((linea) => {\n        const [titulo, nombres = ''] = linea.includes(':') ? linea.split(/:(.*)/s) : ['Mis padrinos', linea];\n        return { titulo: titulo.trim(), nombres: nombres.split(/,| y /).map((n) => n.trim()).filter(Boolean) };\n      }),\n    ],\n  },\n  ceremonias: [\n    ...($('Datos de la misa').isExecuted\n      ? [{\n          icono: 'iglesia',\n          titulo: 'Misa de Agradecimiento',\n          hora: misa['¿A qué hora es la misa?'],\n          lugar: misa['¿En qué iglesia será?'],\n          direccion: misa['Dirección de la iglesia'] || '',\n          mapsUrl: misa['Enlace de Google Maps de la iglesia'] || '',\n        }]\n      : []),\n    {\n      icono: 'copas',\n      titulo: 'Recepción',\n      hora: recepcion['¿A qué hora empieza la recepción?'] || '',\n      lugar: recepcion['¿En qué salón será la fiesta?'],\n      direccion: recepcion['Dirección del salón'] || '',\n      mapsUrl: recepcion['Enlace de Google Maps del salón'] || '',\n    },\n  ],\n  itinerario: lineas(programa['¿Cuál es el programa de la fiesta?']).map((linea) => {\n    const [hora, actividad = ''] = linea.split(/\\s+[-–—]\\s+(.*)/s);\n    return { hora: hora.trim(), actividad: actividad.trim() || hora.trim(), icono: icono(actividad || hora) };\n  }),\n  hoteles: {\n    lista: [\n      ...[].concat(hoteles['Hoteles recomendados'] || []).map((nombre) => HOTELES[nombre]).filter(Boolean),\n      ...lineas(hoteles['¿Algún otro hotel que no esté en la lista?']).map((linea) => {\n        const [nombre, direccion = '', telefono = '', codigo = ''] = linea.split('|').map((p) => p.trim());\n        return { nombre, direccion, distancia: '', telefono, codigo, mapsUrl: '', url: '' };\n      }),\n    ],\n  },\n  dresscode: {\n    titulo: vestimenta['¿Cuál es el código de vestimenta?'] || '',\n    nota: [color && `El color ${color.toLowerCase()} está reservado especialmente para la quinceañera.`, vestimenta['Otra indicación sobre la vestimenta']]\n      .filter(Boolean)\n      .join(' '),\n  },\n  regalos: $('Datos bancarios').isExecuted\n    ? {\n        ...(banco['¿Quieren otro mensaje sobre regalos?'] ? { texto: banco['¿Quieren otro mensaje sobre regalos?'] } : {}),\n        datos: [banco['Banco'], banco['Nombre del titular de la cuenta'], `CLABE ${clabe}`],\n        copiar: clabe,\n      }\n    : { texto: '' },\n  fotosInvitados: {\n    habilitado: detalles['¿Quieren activar el álbum compartido para que los invitados suban fotos durante la fiesta?'] === 'Sí',\n  },\n  notas: lineas(detalles['Notas finales para los invitados']),\n};\n\nconst cancion = detalles['¿Qué canción quiere Camila de fondo en su invitación?'] || '';\nconst quien = contacto['¿Quién llena este formulario?'] || '';\nconst whatsapp = contacto['WhatsApp de contacto'] || '';\nconst comentarios = contacto['¿Algo más que nos quieras contar o pedir?'] || '';\n\n// Fotos de vestimenta y mp3: se quedan en el nodo de su página; se copian\n// aquí para que el correo los lleve como adjuntos.\nconst binary = {};\nfor (const [nodo, prefijo] of [['Vestimenta', 'vestimenta'], ['Detalles', 'cancion']]) {\n  if (!$(nodo).isExecuted) continue;\n  for (const [clave, archivo] of Object.entries($(nodo).first().binary || {})) {\n    binary[`${prefijo}_${clave}`] = archivo;\n  }\n}\n\nconst html = (texto) => String(texto ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst fila = (etiqueta, valor) => (valor ? `<tr><td style=\"padding:4px 12px 4px 0;color:#777\">${etiqueta}</td><td>${html(valor)}</td></tr>` : '');\nconst misaTexto = config.ceremonias.length > 1 ? `${config.ceremonias[0].lugar} · ${config.ceremonias[0].hora}` : 'Sin misa';\nconst salon = config.ceremonias[config.ceremonias.length - 1];\n\nconst cuerpo = `\n<h2 style=\"margin:0 0 12px\">Cuestionario de los XV de Camila</h2>\n<table style=\"border-collapse:collapse;font-size:14px\">\n  ${fila('Respondió', quien)}\n  ${fila('WhatsApp', whatsapp)}\n  ${fila('Fecha', `${fecha} · ${fiesta['¿A qué hora empieza la celebración?'] || ''}`)}\n  ${fila('Misa', misaTexto)}\n  ${fila('Salón', `${salon.lugar} · ${salon.hora}`)}\n  ${fila('Canción', cancion)}\n  ${fila('Color reservado', color)}\n  ${fila('Comentarios', comentarios)}\n  ${fila('Adjuntos', Object.keys(binary).length ? `${Object.keys(binary).length} archivo(s)` : '')}\n</table>\n<p style=\"margin:20px 0 6px\"><b>Para pegar en src/event.config.js:</b></p>\n<pre style=\"background:#f5f5f5;padding:12px;border-radius:6px;font-size:12px;white-space:pre-wrap\">${html(JSON.stringify(config, null, 2))}</pre>`;\n\nreturn [{\n  json: {\n    config,\n    cancion,\n    colorReservado: color || '',\n    contacto: { nombre: quien, whatsapp, comentarios },\n    correo: { asunto: `Cuestionario XV Camila · respondió ${quien}`, html: cuerpo },\n    adjuntos: Object.keys(binary).join(','),\n  },\n  binary,\n}];\n"
      },
