# Plantilla del token local. Cópiala a .env.local y pega tu token:
#
#   cp .env.local.example .env.local
#   source .env.local        # lo carga en la terminal actual
#   terraform plan           # ya con el token disponible
#
# .env.local está en .gitignore: nunca se commitea.
#
# El token se crea en Cloudflare → My Profile → API Tokens → Create Token.
# Permisos: Account→Cloudflare Pages→Edit, Zone→DNS→Edit, Zone→Zone→Read
# (limitados al zone evento.casa).

export CLOUDFLARE_API_TOKEN="PEGA_TU_TOKEN_AQUI"
