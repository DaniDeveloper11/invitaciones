{
  "name": "fotos-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API de fotos de invitados (api.evento.casa): Worker + D1 + R2, compartida por todas las invitaciones.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply invitaciones --local",
    "db:migrate": "wrangler d1 migrations apply invitaciones --remote",
    "db:seed:local": "wrangler d1 execute invitaciones --local --file=seed.local.sql"
  },
  "devDependencies": {
    "wrangler": "^4.149.0"
  }
}
